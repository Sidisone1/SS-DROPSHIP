# Copier en .env (jamais commité). Aucune valeur réelle ici.
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/ss_dropship
# Secret maître (32 caractères minimum), unique par environnement. Obligatoire en production.
APP_SECRET=remplacer-par-un-secret-long-et-aleatoire-0000000000
# Seul « sandbox_journal » existe tant qu'aucun fournisseur SMS/email n'est contracté (refusé en production).
NOTIFICATIONS=sandbox_journal
URL_WEB=http://localhost:3001
