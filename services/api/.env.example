# Copier en .env (jamais commité). Aucune valeur réelle ici.
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/ss_dropship
# Secret maître (32 caractères minimum), unique par environnement. Obligatoire en production.
# Les empreintes des codes de vérification sont des HMAC avec une clé dérivée de ce secret (remplace SS_OTP_PEPPER).
APP_SECRET=remplacer-par-un-secret-long-et-aleatoire-0000000000
URL_WEB=http://localhost:3001

# Notifications (codes de vérification) :
#  - sandbox_journal : TEST uniquement, aucun envoi réel, refusé en production ;
#  - passerelle_https : passerelles HTTPS privées vers les prestataires SMS et email (contrat dans
#    services/api/src/notifications/passerelle-https.ts). Sans passerelle SMS valide, l'API refuse de démarrer.
NOTIFICATIONS=sandbox_journal
SS_SMS_GATEWAY_URL=https://sms.example.invalid/api/verification
SS_SMS_GATEWAY_TOKEN=REMPLACER_PAR_JETON_PRIVE
SS_EMAIL_GATEWAY_URL=https://email.example.invalid/api/verification
SS_EMAIL_GATEWAY_TOKEN=REMPLACER_PAR_JETON_PRIVE
