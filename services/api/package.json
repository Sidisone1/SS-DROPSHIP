{
  "name": "@ss-dropship/api",
  "version": "0.1.0",
  "private": true,
  "description": "API métier SS DROPSHIP (NestJS + PostgreSQL, D-024, ADR-001).",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "swc src -d dist --strip-leading-paths --copy-files",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && node --test prisma/protections.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@ss-dropship/config": "workspace:*",
    "@ss-dropship/types": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@nestjs/testing": "12.4.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
