{
  "name": "@ss-dropship/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Application mobile client SS DROPSHIP (Expo / React Native), 5 onglets.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.19",
    "@ss-dropship/config": "workspace:*",
    "@ss-dropship/i18n": "workspace:*",
    "@ss-dropship/types": "workspace:*",
    "@ss-dropship/ui": "workspace:*",
    "expo": "57.0.32",
    "expo-constants": "57.0.25",
    "expo-linking": "57.0.14",
    "expo-router": "57.0.32",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
