{
  "name": "@ss-dropship/web",
  "version": "0.1.0",
  "private": true,
  "description": "Site client SS DROPSHIP (Next.js), synchronisé avec l'application mobile.",
  "type": "module",
  "scripts": {
    "icones": "node scripts/copier-icones.mjs",
    "dev": "pnpm icones && next dev --port 3001",
    "build": "pnpm icones && next build",
    "start": "next start --port 3001",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ss-dropship/config": "workspace:*",
    "@ss-dropship/i18n": "workspace:*",
    "@ss-dropship/ui": "workspace:*",
    "next": "16.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
